{
  "name": "pdf-testkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Semantic regression testing for generated PDFs — monorepo root",
  "workspaces": [
    "packages/core",
    "packages/matcher-core",
    "packages/protocol",
    "packages/jest",
    "packages/vitest",
    "packages/cli",
    "packages/action",
    "packages/fixtures"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
