{
  "name": "@pdf-testkit/action",
  "version": "0.1.0",
  "description": "GitHub Action (comment-only) that posts pdf-testkit semantic diffs on a PR",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "bundle": "ncc build src/main.ts -o dist --minify"
  },
  "dependencies": {
    "@pdf-testkit/core": "0.1.0",
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3"
  }
}
