{
  "name": "@pdf-testkit/protocol",
  "version": "0.2.0",
  "description": "Ingest protocol between the pdf-testkit CLI and the pdf-testkit cloud service: schemas, types, and a fixture server for tests",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" }
  },
  "files": ["dist", "PROTOCOL.md"],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danmolitor/pdf-testkit.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/danmolitor/pdf-testkit#readme",
  "bugs": "https://github.com/danmolitor/pdf-testkit/issues"
}
